# A unit cube centered at the origin, with explicit per-face normals and quad faces (to
# exercise fan-triangulation), split across two materials (with mtllib-supplied Kd colors) to
# test usemtl/mtllib parsing.
mtllib cube.mtl

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

usemtl red
f 1//1 2//1 3//1 4//1
f 5//2 8//2 7//2 6//2

usemtl blue
f 1//3 4//3 8//3 5//3
f 2//4 6//4 7//4 3//4
f 1//5 5//5 6//5 2//5
f 4//6 3//6 7//6 8//6
