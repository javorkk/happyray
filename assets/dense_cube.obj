# A unit cube centered at the origin, tessellated into N x N quads per face,
# used to exercise the two-level grid's dense-cell (non-degenerate second-level)
# refinement path (see tests/tracer_tests.cpp). N=4 -> 96 triangles.
mtllib dense_cube.mtl

