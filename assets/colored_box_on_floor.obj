# Same geometry as box_on_floor.obj, but with mtllib-driven materials (a light gray floor and a
# reddish-orange box) to visually demonstrate Lambert diffuse color tinting the AO render.
mtllib colored_box_on_floor.mtl

v -3.0 0.0 -3.0
v  3.0 0.0 -3.0
v  3.0 0.0  3.0
v -3.0 0.0  3.0

v -0.5 0.0 -0.5
v  0.5 0.0 -0.5
v  0.5 0.0  0.5
v -0.5 0.0  0.5
v -0.5 1.0 -0.5
v  0.5 1.0 -0.5
v  0.5 1.0  0.5
v -0.5 1.0  0.5

vn 0.0 1.0 0.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0

usemtl floor
f 1//1 2//1 3//1 4//1

usemtl box
f 5//2 6//2 10//2 9//2
f 7//3 8//3 12//3 11//3
f 8//4 5//4 9//4 12//4
f 6//5 7//5 11//5 10//5
f 9//1 10//1 11//1 12//1
